[Unit]
Description=Memetrading Analysis Pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/memetrading
EnvironmentFile=/opt/memetrading/.env
ExecStart=/opt/memetrading/.venv/bin/python -m app.main --mode all --limit 100 --poll-seconds 5
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
