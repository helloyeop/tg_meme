APP_ENV=local
DRY_RUN=true

# Telethon user account login for reading public/private channels.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=telegram_call_bot
TELEGRAM_SESSION_DIR=./sessions

# Personal Telegram bot for outbound alerts only.
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# LLM message classification. Every Telegram message is analyzed in v1.
# OpenAI primary classification: low-cost structured classification, with selective mini review.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-5.4-nano
LLM_BASE_URL=
LLM_ENABLED=true
# Recheck low-confidence high-impact signals before paper-trading logic consumes them.
LLM_REVIEW_ENABLED=true
LLM_REVIEW_MODEL=gpt-5.4-mini
LLM_REVIEW_CONFIDENCE_THRESHOLD=0.75
LLM_REVIEW_INTENTS=BUY_CALL,WARNING,SOLD,TAKE_PROFIT
# Local fallback remains available if the API is unreachable.
LLM_FALLBACK_TO_OLLAMA=true
# For a CA-only post, link exactly one unused same-channel entry context within this window.
CONTEXT_LINKING_ENABLED=true
CONTEXT_LINK_WINDOW_SECONDS=60
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=60

# Data source priority: GMGN -> DexScreener -> Helius.
GMGN_API_KEY=
# Preferred v1 integration is read-only GMGN CLI/Skills. Install gmgn-cli separately if used.
GMGN_CLI_PATH=./node_modules/.bin/gmgn-cli
# Optional/experimental only. Leave blank unless GMGN provides a data API base URL.
GMGN_BASE_URL=
DEXSCREENER_BASE_URL=https://api.dexscreener.com
HELIUS_API_KEY=
HELIUS_RPC_URL=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Future optional adapter only. Real trading is not implemented in v1.
SOLANA_AGENT_KIT_ENABLED=false

# Guarded live trading. Paper trading remains independent and enabled.
# Keep disabled until the isolated signer service has been configured and verified.
LIVE_ORDER_STAGING_ENABLED=false
LIVE_EXECUTION_ADAPTER=disabled
LIVE_WALLET_PUBLIC_KEY=FFDuhHWsDuoUrFAY3Ggk8gty8EeNjArrXLC21UcULvvh
LIVE_SIGNER_BASE_URL=http://signer:8787
LIVE_SIGNER_AUTH_TOKEN=
LIVE_SIGNER_KEYPAIR_PATH=/run/wallet-secrets/live-wallet.json
JUPITER_API_KEY=
JUPITER_SWAP_BASE_URL=https://api.jup.ag/swap/v2

DATABASE_URL=sqlite:///./data/app.db
# Normalized snapshot columns drive scoring and dashboard views. Raw API payloads grow quickly.
STORE_MARKET_SNAPSHOT_RAW_JSON=false
STORE_SECURITY_SNAPSHOT_RAW_JSON=false

PAPER_INITIAL_BALANCE_SOL=20
PAPER_ENTRY_SIZE_SOL=0.5
PAPER_DAILY_MAX_LOSS_SOL=2
OPEN_EVENT_REFRESH_SECONDS=300
# Open paper positions only: one official DexScreener batch request for up to 30 tokens.
# 5 seconds = 12 requests/minute, well within the guarded 240/minute app budget.
PAPER_FAST_MONITOR_ENABLED=true
PAPER_FAST_MONITOR_SECONDS=5
PAPER_FAST_MONITOR_MAX_TOKENS=30
# Closed paper positions are observed for counterfactual strategy analysis, not live exit decisions.
# Recent snapshots from an open position for the same token are reused without an extra request.
PAPER_CLOSED_MONITOR_ENABLED=true
PAPER_CLOSED_MONITOR_SECONDS=900
PAPER_CLOSED_MONITOR_MAX_TOKENS=30
# DexScreener's documented token endpoint limit is 300/minute; keep reserve for call ingestion.
DEXSCREENER_REQUEST_BUDGET_PER_MINUTE=240

LOG_LEVEL=INFO
